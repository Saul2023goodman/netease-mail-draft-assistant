{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "3.8.0",
  "description": "网易邮箱外联工作台：文件、草稿箱与历史邮件统一导入为外联任务；自动核验与排期，执行时保留网易原生 Fw/Re、回复识别与附件完整性。",
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "action": {
    "default_title": "打开网易邮箱外联工作台"
  },
  "background": {
    "service_worker": "background-entry.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "executor.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
