{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "4.1.0",
  "description": "网易邮箱外联工作台：统一导入、自动识别、异常核验、排期与草稿执行；历史邮件和联系人仅作为任务上下文与补充来源。",
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "action": {
    "default_title": "打开网易邮箱外联工作台"
  },
  "background": {
    "service_worker": "background-entry.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "executor.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
